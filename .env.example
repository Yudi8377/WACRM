# App
NODE_ENV=production
APP_DOMAIN=crm.example.com
WACRM_IMAGE=ghcr.io/yudi8377/wacrm:main
APP_URL=https://crm.example.com
APP_ENCRYPTION_KEY=
# Generate a random 32-byte key and encode as base64; never commit the real value.

# Neon PostgreSQL
DATABASE_URL=
# Dedicated, non-BYPASSRLS worker role; used only by the separate worker process.
WEBHOOK_WORKER_DATABASE_URL=

# Auth provider - configure before exposing the app publicly
AUTH_SECRET=
# Use a unique random secret with at least 32 characters in every environment.
AUTH_URL=https://crm.example.com

# Meta app (WhatsApp Cloud API, Facebook Messenger, Instagram Messaging)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=https://crm.example.com/api/connectors/meta/callback

# TikTok Business Messaging
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://crm.example.com/api/connectors/tiktok/callback

# Google / YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.com/api/connectors/google/callback
YOUTUBE_API_KEY=

# Rate limiting / jobs - production should use a shared store and durable queue
REDIS_URL=
