# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
# Generate a random 32-byte key and encode as base64; never commit the real value.

# Neon PostgreSQL
DATABASE_URL=

# Auth provider - configure before exposing the app publicly
AUTH_SECRET=
# Use a unique random secret with at least 32 characters in every environment.
AUTH_URL=http://localhost:3000

# Meta app (WhatsApp Cloud API, Facebook Messenger, Instagram Messaging)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/meta/callback

# TikTok Business Messaging
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/connectors/tiktok/callback

# Google / YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback
YOUTUBE_API_KEY=

# Rate limiting / jobs - production should use a shared store and durable queue
REDIS_URL=
