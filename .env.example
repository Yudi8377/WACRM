# ==============================================================================
# WACRM Commercial OS — Environment Variables Template (Rp 0 -> Pro Scale)
# ==============================================================================
# App & Core Security
NODE_ENV=production
APP_DOMAIN=crm.example.com
APP_URL=https://crm.example.com
APP_BASE_URL=https://crm.example.com
WACRM_IMAGE=ghcr.io/yudi8377/wacrm:main
AUTH_SECRET=
# Generate >= 32 random chars for AUTH_SECRET
APP_ENCRYPTION_KEY=
# Generate 32-byte base64 key (openssl rand -base64 32); used for AES-256-GCM encryption
CRON_SECRET=
PUBLISHER_SYNC_SECRET=
PUBLISHER_LICENSE_API_URL=https://wacrm-publisher-hq.vercel.app

# Database — Neon PostgreSQL OR Supabase PostgreSQL (Rp 0 Free Tier -> Paid Pro)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
WEBHOOK_WORKER_DATABASE_URL=

# ==============================================================================
# 1) Email OTP Lupa Sandi Gratis (pilih salah satu — Rp 0,- boleh komersial!)
#    - Resend Free: https://resend.com (3.000 email/bulan gratis)
#    - Brevo Free:  https://brevo.com  (300 email/hari gratis)
# ==============================================================================
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@wacrm.id
EMAIL_FROM_NAME="WACRM Commercial OS"
# Opsional: custom SMTP/Cloudflare Email Worker webhook
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# ==============================================================================
# 2) Mode Transfer Manual Rp 0,- (aktif otomatis saat API Key Payment Gateway kosong)
# ==============================================================================
MANUAL_BANK_NAME="Bank BCA / QRIS Resmi WACRM"
MANUAL_BANK_ACCOUNT=
MANUAL_BANK_HOLDER="PT WACRM Digital Nusantara"
MANUAL_BILLING_WA=6281234567890

# ==============================================================================
# 3) Payment Gateway Otomatis Indonesia (Rp 0 daftar & Rp 0/bln — bayar MDR per transaksi)
#    PAYMENT_PROVIDER: manual_transfer | midtrans | xendit | tripay
# ==============================================================================
PAYMENT_PROVIDER=manual_transfer

# Midtrans Snap (Webhook: /api/webhooks/payment?provider=midtrans)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

# Xendit Invoice v2 (Webhook: /api/webhooks/payment?provider=xendit)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Tripay Closed Payment (Webhook: /api/webhooks/payment?provider=tripay)
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_IS_PRODUCTION=true

# ==============================================================================
# 4) Omnichannel Connectors (Meta WhatsApp Cloud API, TikTok, YouTube)
# ==============================================================================
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=https://crm.example.com/api/connectors/meta/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://crm.example.com/api/connectors/tiktok/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.com/api/connectors/google/callback
YOUTUBE_API_KEY=

# Optional Redis for distributed rate limiting
REDIS_URL=
